PORT=4000
HOST=127.0.0.1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

WA_SERVER_NODE_ID=VPS-1
WA_DASHBOARD_USERNAME=operator
WA_DASHBOARD_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_OF_16_OR_MORE_CHARACTERS
WA_DASHBOARD_RATE_LIMIT=120
WA_DASHBOARD_RATE_WINDOW_MS=60000
TRUST_PROXY_HOPS=1
# Production install: npm ci --omit=optional
WHATSAPP_POLL_INTERVAL_MS=3000
WHATSAPP_BATCH_SIZE=10
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_STALE_PROCESSING_MINUTES=5
WHATSAPP_FAILURE_AUTOPAUSE_THRESHOLD=5
