{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "sanabil"
      }
    },
    "sanabil": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "sanabil"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "alsunna": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "alsunna"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "alxikma": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "alxikma"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "schoolb": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "schoolb"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "schoolc": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "schoolc"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "schoold": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "schoold"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "production-sanabil": {
      "environment": "production",
      "env": {
        "APP_VARIANT": "sanabil"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    },
    "production-alsunna": {
      "environment": "production",
      "env": { "APP_VARIANT": "alsunna" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "production-alxikma": {
      "environment": "production",
      "env": { "APP_VARIANT": "alxikma" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "production-schoolb": {
      "environment": "production",
      "env": { "APP_VARIANT": "schoolb" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "production-schoolc": {
      "environment": "production",
      "env": { "APP_VARIANT": "schoolc" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    },
    "production-schoold": {
      "environment": "production",
      "env": { "APP_VARIANT": "schoold" },
      "android": { "buildType": "app-bundle", "autoIncrement": true }
    }
  },
  "submit": {
    "production-sanabil": {},
    "production-alsunna": {},
    "production-alxikma": {},
    "production-schoolb": {},
    "production-schoolc": {},
    "production-schoold": {}
  }
}
